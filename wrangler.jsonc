// Cloudflare Workers config (free plan). Deploy: `pnpm deploy:cf`, or connect
// the repo in the Cloudflare dashboard (Workers & Pages → Create → Import a
// repository). See README "Deploying (Cloudflare Workers, free)".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftwise",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
}
