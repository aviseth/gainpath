# Copy to .env.local and fill in. Every variable is optional: without them the
# app runs fully local-only (IndexedDB) with JSON export/import as backup.

# Supabase (Project Settings → API). The publishable key is safe in the browser;
# Row Level Security protects the data. A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Added in later milestones (server-side only, never prefixed NEXT_PUBLIC_):
# ANTHROPIC_API_KEY=            # milestone 5, opt-in AI features
# GOOGLE_HEALTH_CLIENT_ID=      # milestone 8
# GOOGLE_HEALTH_CLIENT_SECRET=  # milestone 8
